{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "homelab": {
      "name": "Homelab",
      "env": ["AI_API_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:AI_LLM_URL}/v1"
      },
      "models": {
        "qwen3-coder-q8": {
          "modelID": "qwen3-coder-next:q8_0",
          "name": "Qwen 3 Coder q8",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-9b": {
          "modelID": "qwen3.5:9b",
          "name": "Qwen 3.5 9b",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3-coder": {
          "modelID": "qwen3-coder-next:latest",
          "name": "Qwen 3 Coder",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
