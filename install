#!/usr/bin/env bash

set -euo pipefail

get_packages() {
  find . -maxdepth 2 -type d \
    -exec test -f '{}/install' \; \
    -exec test -d '{}/install.d' \; \
    -print
}

get_modules() {
  find . -maxdepth 2 -type d \
    -exec test -f '{}/install.d/*.sh' \; \
    -print
}

mapfile -t packages < <(get_packages)

for package in ${packages[@]}; do 
  echo "$package"
done | fzf --prompt "Select one or more packages:" -m
